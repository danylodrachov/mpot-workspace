{
  "name": "afk-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AFK agent — Orchestrator + reader subagents (Node.js/TypeScript, ADR 0020)",
  "scripts": {
    "gmail:auth": "node src/gmail/auth.ts",
    "tg:push": "node src/telegram/push.ts",
    "tg:gate": "node src/telegram/gate.ts",
    "day:build": "bash bin/build-day.sh",
    "fetch:day": "bash bin/build-day.sh && node src/ingest/fetch-to-day.ts",
    "day:check": "bash bin/check-day.sh",
    "labels:check": "node bin/check-labels.ts",
    "orc:run": "node bin/run-orc.ts",
    "day": "bash bin/run-day.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:research": "node --experimental-strip-types --test 'src/research/**/*.test.ts' 'tests/research/**/*.test.ts'",
    "research:run": "node bin/run-research.ts",
    "research:validate": "npm run typecheck && npm run test:research"
  },
  "dependencies": {
    "@googleapis/gmail": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "email-reply-parser": "^2.3.5",
    "exceljs": "^4.4.0",
    "gmail-api-parse-message": "^2.1.2",
    "google-auth-library": "^9.0.0",
    "googleapis": "^144.0.0",
    "grammy": "^1.34.0",
    "html-to-text": "^9.0.5",
    "p-limit": "^7.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "playwright": "^1.45.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
