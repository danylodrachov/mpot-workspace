{
  "permissions": {
    "allow": [
      "Bash(nohup env -u CLAUDECODE claude -p --agent casino-session *)",
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability.sh *)",
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability-init.sh *)",
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability-context.sh *)",
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability-finalize.sh *)",
      "Bash(${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-session-end.sh *)",
      "mcp__playwright__*",
      "Write(.runtime/casino/spawn-next)",
      "Write(.runtime/casino/batch.done)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Finalizing observability, then launching next casino unit",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-session-end.sh",
            "args": [],
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/audit-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/adr-guard.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh \"Claude Code\" \"Claude has finished responding\" \"Pop\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh \"Claude Code — Action Needed\" \"Permission approval required\" \"Funk\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/casino-observability.sh",
